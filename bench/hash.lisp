;; SYSTEMS="natrium seal ..." BYTES=N  sbcl --script | modus --script
(require :asdf)
(asdf:initialize-source-registry
  `(:source-registry (:tree ,(uiop:ensure-directory-pathname (or (uiop:getenv "WORKSPACE") (uiop:getcwd)))) :ignore-inherited-configuration))
(defvar *systems* (uiop:split-string (or (uiop:getenv "SYSTEMS") "natrium") :separator " "))
(defvar *n* (parse-integer (or (uiop:getenv "BYTES") "1048576")))
(dolist (s *systems*)
  (cond ((string= s "") nil)
        ;; beacon's socket layer needs sb-unix; its hashes need only these three files
        ((string= s "beacon-hash")
         (asdf:load-system "secp256k1-fast")
         (dolist (f '("packages" "util" "hash"))
           (load (format nil "~a/beacon/src/~a.lisp" (or (uiop:getenv "WORKSPACE") (uiop:getcwd)) f))))
        (t (asdf:load-system s))))
(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second)))
(defun hex (x) (if (stringp x) (string-downcase x)
                   (with-output-to-string (o) (loop for b across x do (format o "~(~2,'0x~)" b)))))
(defvar *data* (let ((v (make-array *n* :element-type '(unsigned-byte 8))))
                 (dotimes (i *n* v) (setf (aref v i) (logand (* i 131) 255)))))
(defun fn (pkg name) (let ((p (find-package pkg))) (and p (let ((s (find-symbol name p))) (and s (fboundp s) (symbol-function s))))))
(defvar *cands*
  (list (list "SHA-1" "natrium" (fn "NATRIUM" "SHA1"))
        (list "SHA-1" "seal" (let ((i (fn "SEAL" "SHA1-INIT")) (u (fn "SEAL" "SHA1-UPDATE")) (f (fn "SEAL" "SHA1-FINAL")))
                               (and i (lambda (d) (let ((s (funcall i))) (funcall u s d) (funcall f s))))))
        (list "SHA-1" "beacon" (fn "BEACON" "SHA1"))
        (list "SHA-256" "natrium" (fn "NATRIUM" "SHA256"))
        (list "SHA-256" "beacon" (fn "BEACON" "SHA256"))
        (list "SHA-256" "folio" (fn "FOLIO" "SHA256"))
        (list "SHA-256" "cl-sev-snp" (fn "CL-SEV-SNP" "SHA256"))
        (list "SHA-512" "natrium" (fn "NATRIUM" "SHA512"))
        (list "SHA-512" "folio" (fn "FOLIO" "SHA512"))
        (list "SHA-512" "cl-sev-snp" (fn "CL-SEV-SNP" "SHA512"))))
(defvar *want* (make-hash-table :test 'equal))
(dolist (c *cands*)
  (destructuring-bind (alg who f) c
    (when f
      (funcall f (subseq *data* 0 (min *n* 65536)))
      (let* ((r (funcall f *data*)) (h (hex r)) (w (gethash alg *want*))
             (t0 (now)) (reps 0))
        (loop do (funcall f *data*) (incf reps) until (> (- (now) t0) 0.5))
        (let ((dt (- (now) t0)))
          (unless w (setf (gethash alg *want*) h))
          (format t "~a ~a ~,2f MB/s x~d ~a~%" alg who (/ (* reps *n*) dt 1e6) reps
                  (if (or (null w) (string= w h)) "ok" (format nil "MISMATCH ~a" h)))
          (finish-output))))))
