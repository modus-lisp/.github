;; WORKSPACE=dir (or CRAMDIR=dir/cram/)  sbcl --script / modus --script
(require :asdf)
(push (uiop:ensure-directory-pathname (or (uiop:getenv "CRAMDIR") (merge-pathnames "cram/" (uiop:ensure-directory-pathname (or (uiop:getenv "WORKSPACE") (uiop:getcwd)))))) asdf:*central-registry*)
(asdf:load-system :cram)
(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second)))
(let* ((n (* 2 1024 1024))
       (raw (let ((v (make-array n :element-type '(unsigned-byte 8))) (s 12345))
              ;; text-like: words from a small alphabet, compressible ~3x
              (dotimes (i n v) (setf s (mod (+ (* s 1103515245) 12345) 2147483648))
                (setf (aref v i) (if (zerop (mod (ash s -16) 7)) 32 (+ 97 (mod (ash s -20) 12)))))))
       (z (cram:zlib-compress raw)))
  (format t "raw ~d z ~d~%" n (length z))
  (let ((t0 (now)) out)
    (dotimes (k 3) (setf out (cram:zlib-decompress z)))
    (let ((dt (/ (- (now) t0) 3)))
      (format t "inflate ~,1f MB/s ok=~a~%" (/ n dt 1e6) (equalp out raw))))
  (let ((t0 (now)) c)
    (dotimes (k 5) (setf c (cram:crc32 raw)))
    (format t "crc32 ~,1f MB/s ~x~%" (/ (* 5 n) (- (now) t0) 1e6) c))
  (let ((t0 (now)) c)
    (dotimes (k 5) (setf c (cram:adler32 raw)))
    (format t "adler32 ~,1f MB/s ~x~%" (/ (* 5 n) (- (now) t0) 1e6) c)))
