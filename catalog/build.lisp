;;;; catalog/build.lisp -- write CATALOG.md: every repo in the workspace, what it is,
;;;; its systems, and what each of its packages exports.
;;;;
;;;;   sbcl --script .github/catalog/build.lisp        (from the workspace root)
;;;;   WORKSPACE=dir OUT=file sbcl --script ...         (elsewhere)
;;;;
;;;; Nothing is loaded or compiled: .asd files and DEFPACKAGE forms are READ as data,
;;;; with *READ-EVAL* off, so a repo that does not build on this machine is still listed.
(defpackage #:catalog (:use #:cl))
(in-package #:catalog)

(defvar *root* (truename (or (sb-ext:posix-getenv "WORKSPACE") *default-pathname-defaults*)))

;;; Read every form of FILE into a throwaway package, so names in it intern nowhere that
;;; matters.  A package prefix the reader does not know is a reader error: the form is
;;; skipped and the rest of the file still read.
(defvar *scratch* (make-package "CATALOG-SCRATCH" :use nil))

(defun read-forms (file)
  (with-open-file (in file :external-format :utf-8)
    (let ((*package* *scratch*) (*read-eval* nil) (forms '()))
      (loop
        (let ((f (handler-case (read in nil in)
                   (end-of-file () in)
                   (reader-error () (read-line in nil) :skip)
                   (error () (read-line in nil) :skip))))
          (cond ((eq f in) (return (nreverse forms)))
                ((consp f) (push f forms))))))))

(defun head= (form name) (and (consp form) (symbolp (car form)) (string= (symbol-name (car form)) name)))
(defun key (plist name)
  (loop for (k v) on plist by #'cddr
        when (and (symbolp k) (string= (symbol-name k) name)) return v))
(defun name-of (x) (if (symbolp x) (string-downcase (symbol-name x)) (princ-to-string x)))
(defun one-line (s)
  "S on one line, each run of whitespace one space."
  (when (stringp s)
    (with-output-to-string (o)
      (let ((gap nil))
        (loop for c across (string-trim '(#\Space #\Tab #\Newline) s)
              do (if (member c '(#\Space #\Tab #\Newline #\Return))
                     (setf gap t)
                     (progn (when gap (write-char #\Space o) (setf gap nil)) (write-char c o))))))))

(defun systems (dir)
  (loop for asd in (directory (merge-pathnames "*.asd" dir))
        append (loop for f in (read-forms asd)
                     when (head= f "DEFSYSTEM")
                       collect (list (name-of (second f))
                                     (one-line (key (cddr f) "DESCRIPTION"))
                                     (let ((d (key (cddr f) "DEPENDS-ON")))
                                       (and (listp d) (mapcar #'name-of d)))))))

(defun lisp-files (dir)
  "The .lisp files git tracks in DIR (so scratch and build output are not catalogued),
   outside test and vendored trees."
  (let ((out (with-output-to-string (o)
               (sb-ext:run-program "git" (list "-C" (namestring dir) "ls-files" "-z" "--" "*.lisp")
                                   :search t :output o :error nil))))
    (loop for start = 0 then (1+ end)
          for end = (position (code-char 0) out :start start)
          while end
          for rel = (subseq out start end)
          unless (some (lambda (part) (member part '("test" "tests" "t" "vendor" "inspect")
                                              :test #'string=))
                       (butlast (uiop-free-split rel)))
            collect (merge-pathnames rel dir))))

(defun uiop-free-split (path)
  (loop for start = 0 then (1+ end)
        for end = (position #\/ path :start start)
        collect (subseq path start end)
        while end))

(defun packages (dir)
  (loop for file in (lisp-files dir)
        append (loop for f in (ignore-errors (read-forms file))
                     when (head= f "DEFPACKAGE")
                       collect (list (name-of (second f))
                                     (sort (loop for opt in (cddr f)
                                                 when (head= opt "EXPORT")
                                                   append (mapcar #'name-of (rest opt)))
                                           #'string<)
                                     (enough-namestring file *root*)))))

(defun repos ()
  (sort (remove-if-not (lambda (d) (probe-file (merge-pathnames ".git" d)))
                       (directory (merge-pathnames "*/" *root*)))
        #'string< :key (lambda (d) (car (last (pathname-directory d))))))

(defun main ()
  (with-open-file (o (or (sb-ext:posix-getenv "OUT") (merge-pathnames ".github/CATALOG.md" *root*))
                     :direction :output :if-exists :supersede :external-format :utf-8)
    (format o "# Catalog of the modus-lisp workspace~%~%~
Generated by `.github/catalog/build.lisp` from each repo's .asd and DEFPACKAGE forms; do not
edit by hand.  For each repo: what its systems say they are, what they depend on, and every
symbol each package exports.  **Grep this before writing anything that sounds generic**
(`grep -n base64 .github/CATALOG.md`), and read `AGENTS.md` for which copy is canonical.~%")
    (let* ((all (mapcar (lambda (dir) (list (car (last (pathname-directory dir)))
                                            (systems dir) (packages dir)))
                        (repos)))
           (owners (make-hash-table :test 'equal)))
      ;; every exported name -> the repos whose packages export it
      (loop for (repo nil pkgs) in all
            do (loop for (nil exports) in pkgs
                     do (dolist (e exports) (pushnew repo (gethash e owners) :test #'string=))))
      (let ((dups (sort (loop for k being the hash-keys of owners using (hash-value v)
                              when (rest v) collect (cons k (sort (copy-list v) #'string<)))
                        #'string< :key #'car)))
        (format o "~%## Names exported by more than one repo~%~%~
Often the same thing written twice -- the first place to look for a copy to delete.  (Some are
deliberate: protocol names, or a repo re-exporting a dependency.)~%~%")
        (dolist (d dups) (format o "- `~a`: ~{~a~^, ~}~%" (car d) (cdr d))))
      (loop for (name sys pkgs) in all do
        (when (or sys pkgs)
          (format o "~%## ~a~%~%" name)
          (dolist (s sys)
            (format o "- system `~a`~@[ -- ~a~]~@[  ~%  depends on: ~{`~a`~^, ~}~]~%"
                    (first s) (second s) (third s)))
          (dolist (p pkgs)
            (format o "- package `~a` (~a)~:[~;: ~:*~{`~a`~^ ~}~]~%" (first p) (third p) (second p))))))))

(main)
